<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FantaMultiple - Prove Multiple Atletica</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <div class="header-container">
            <h1>🏃‍♂️ FantaMultiple</h1>
            <nav>
                <button class="nav-btn active" data-target="home">Home</button>
                <button class="nav-btn" data-target="squadre">Squadre</button>
                <button class="nav-btn" data-target="atleti">Atleti</button>
                <button class="nav-btn" data-target="gare">Gare</button>
                <button class="nav-btn" data-target="classifica">Classifica</button>
            </nav>
            <div class="admin-controls">
                <span id="admin-status" class="badge badge-user">Modalità Ospite</span>
                <button id="btn-login" class="btn-outline">Login Admin</button>
                <button id="btn-logout" class="btn-danger hidden">Esci</button>
            </div>
        </div>
    </header>

    <main>
        <!-- SEZIONE HOME -->
        <section id="home" class="page-section active">
            <h2>Panoramica FantaMultiple</h2>
            <div class="stats-grid">
                <div class="stat-card">
                    <h3>Squadre Iscritte</h3>
                    <p id="stat-teams-count" class="stat-number">0</p>
                </div>
                <div class="stat-card">
                    <h3>Atleti Totali</h3>
                    <p id="stat-athletes-count" class="stat-number">0</p>
                </div>
                <div class="stat-card highlight">
                    <h3>🥇 Prima Squadra</h3>
                    <p id="stat-top-team" class="stat-leader">-</p>
                    <small id="stat-top-team-pts">0 pt</small>
                </div>
                <div class="stat-card highlight">
                    <h3>🥇 Primo Atleta</h3>
                    <p id="stat-top-athlete" class="stat-leader">-</p>
                    <small id="stat-top-athlete-pts">0 pt</small>
                </div>
            </div>

            <div class="info-box">
                <h3>Regolamento Calcolo Punteggi (World Athletics)</h3>
                <p>I punteggi vengono calcolati utilizzando le formule ufficiali World Athletics per le prove multiple: <code>INT(A * (B - T)^C)</code> per le corse e <code>INT(A * (D - B)^C)</code> per salti e lanci (con misure espresse in centimetri).</p>
            </div>
        </section>

        <!-- SEZIONE SQUADRE -->
        <section id="squadre" class="page-section">
            <h2>Gestione Squadre</h2>
            
            <div class="admin-only card form-card hidden">
                <h3>Aggiungi Nuova Squadra</h3>
                <form id="form-team">
                    <div class="form-row">
                        <input type="text" id="team-name" placeholder="Nome Squadra (es. Atletica Milano)" required>
                        <button type="submit" class="btn-primary">Aggiungi Squadra</button>
                    </div>
                </form>
            </div>

            <div class="card">
                <h3>Elenco Squadre</h3>
                <table id="table-teams">
                    <thead>
                        <tr>
                            <th>Nome Squadra</th>
                            <th>Atleti in Rosa</th>
                            <th>Punteggio Totale</th>
                            <th class="admin-only hidden">Azioni</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>

        <!-- SEZIONE ATLETI -->
        <section id="atleti" class="page-section">
            <h2>Gestione Atleti</h2>

            <div class="admin-only card form-card hidden">
                <h3>Aggiungi Nuovo Atleta</h3>
                <form id="form-athlete">
                    <div class="form-grid">
                        <input type="text" id="athlete-name" placeholder="Nome" required>
                        <input type="text" id="athlete-surname" placeholder="Cognome" required>
                        <select id="athlete-gender" required>
                            <option value="">Sesso...</option>
                            <option value="M">Maschio (M)</option>
                            <option value="F">Femmina (F)</option>
                        </select>
                        <select id="athlete-category" required>
                            <option value="">Categoria...</option>
                            <option value="Allievi">Allievi/e (U18)</option>
                            <option value="Junior">Junior (U20)</option>
                            <option value="Promesse">Promesse (U23)</option>
                            <option value="Assoluti">Assoluti/e</option>
                        </select>
                        <select id="athlete-team" required>
                            <option value="">Seleziona Squadra...</option>
                        </select>
                        <button type="submit" class="btn-primary">Registra Atleta</button>
                    </div>
                </form>
            </div>

            <div class="card">
                <h3>Elenco Atleti</h3>
                <table id="table-athletes">
                    <thead>
                        <tr>
                            <th>Atleta</th>
                            <th>Sesso</th>
                            <th>Categoria</th>
                            <th>Squadra</th>
                            <th>Punti Totali</th>
                            <th class="admin-only hidden">Azioni</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>

        <!-- SEZIONE GARE -->
        <section id="gare" class="page-section">
            <h2>Risultati e Gare</h2>

            <div class="admin-only card form-card hidden">
                <h3>Inserisci Risultato Gara</h3>
                <form id="form-race">
                    <div class="form-grid">
                        <select id="race-athlete" required>
                            <option value="">1. Seleziona Atleta...</option>
                        </select>
                        <select id="race-type" required disabled>
                            <option value="">2. Seleziona Specialità / Gara...</option>
                        </select>
                        <input type="date" id="race-date" required>
                    </div>

                    <div id="race-specs-info" class="specs-banner hidden"></div>
                    <div id="race-inputs-container" class="race-inputs"></div>

                    <div class="form-footer">
                        <div class="live-score">Punteggio Calcolato: <strong id="preview-points">0</strong> pt</div>
                        <button type="submit" class="btn-primary" id="btn-save-race" disabled>Salva Risultato</button>
                    </div>
                </form>
            </div>

            <div class="card">
                <div class="filter-bar">
                    <h3>Storico Gare Disputate</h3>
                    <select id="filter-race-athlete">
                        <option value="ALL">Tutti gli atleti</option>
                    </select>
                </div>
                <table id="table-races">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Atleta (Cat.)</th>
                            <th>Specialità</th>
                            <th>Dettaglio Prestazioni</th>
                            <th>Punti WA</th>
                            <th class="admin-only hidden">Azioni</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>

        <!-- SEZIONE CLASSIFICA -->
        <section id="classifica" class="page-section">
            <h2>Classifiche Generali</h2>
            
            <div class="rankings-layout">
                <div class="card">
                    <h3>🏆 Classifica Squadre</h3>
                    <table id="ranking-teams">
                        <thead>
                            <tr>
                                <th>Pos.</th>
                                <th>Squadra</th>
                                <th>Atleti</th>
                                <th>Punti</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div class="card">
                    <h3>🏅 Classifica Individuale Atleti</h3>
                    <table id="ranking-athletes">
                        <thead>
                            <tr>
                                <th>Pos.</th>
                                <th>Atleta</th>
                                <th>Cat.</th>
                                <th>Squadra</th>
                                <th>Punti</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <!-- MODALE LOGIN ADMIN -->
    <div id="login-modal" class="modal hidden">
        <div class="modal-content">
            <h3>Accesso Amministratore</h3>
            <p>Inserisci la password per modificare squadre, atleti e gare.</p>
            <input type="password" id="admin-password" placeholder="Password...">
            <p id="login-error" class="error-text hidden">Password errata!</p>
            <div class="modal-actions">
